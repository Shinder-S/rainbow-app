# Rainbow OS — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# NADA de esto se commitea: .env* está en .gitignore (salvo este .example).

# --- Supabase (OBLIGATORIO, sin respaldo en el código) ----------------------
# Supabase → Project Settings → API Keys.
# Las dos son PÚBLICAS por diseño: viajan en el navegador y lo que protege los
# datos es la RLS. Preferí la clave nueva `sb_publishable_...`.
# OJO: NEXT_PUBLIC_* se inlinea en tiempo de build; cambiarla pide redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- IA (Claude vía API) — todavía no se usa ---------------------------------
# Se llama SÓLO desde el servidor (Route Handlers). Nunca con prefijo NEXT_PUBLIC_.
# Sonnet para correcciones y clases, Haiku para avisos.
ANTHROPIC_API_KEY=

# --- Sitio público ---------------------------------------------------------
# Dominio de la landing, para la imagen al compartir en WhatsApp/redes.
NEXT_PUBLIC_SITE_URL=
